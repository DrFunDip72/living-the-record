; Engine configuration file.
config_version=5

[application]

config/name="Living the Record"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Game="*res://scripts/autoload/Game.gd"
HighScores="*res://scripts/autoload/HighScores.gd"
Fx="*res://scripts/autoload/Fx.gd"
Transition="*res://scripts/autoload/Transition.gd"
Touch="*res://scripts/autoload/Touch.gd"

[gui]

theme/custom="res://theme/GameTheme.tres"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
